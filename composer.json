{
    "name": "washi/monorepo",
    "description": "Development workspace for the Washi packages (not published).",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "packages/support", "options": { "symlink": true } },
        { "type": "path", "url": "packages/db",      "options": { "symlink": true } },
        { "type": "path", "url": "packages/washi",   "options": { "symlink": true } }
    ],
    "require": {
        "php": ">=8.1",
        "washi/support": "@dev",
        "washi/db": "@dev",
        "washi/washi": "@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": { "sort-packages": true }
}
