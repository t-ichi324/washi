# 既定値（コミットする）。環境ごとの値は同じ形式で .env（gitignore）に書けば上書きされる。
# 優先順位: 実環境変数 > .env > .env.defaults
# 秘密情報（パスワードや API キー）はここに書かない。キー名だけコメントで示す。
#
# サンプルなので .env が無くても動くよう開発向けの値にしている。
# 実アプリでは本番で安全な値（APP_DEBUG=false など）を既定にし、開発機の .env で true にする。
APP_DEBUG=true
DB_AUTO_MIGRATE=true

# DB_DRIVER 未設定なら storage/app.db の SQLite
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_DATABASE=notes
# DB_USERNAME=root
# DB_PASSWORD=
